{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bailian CLI result 1.0",
  "type": "object",
  "required": ["schema_version", "tool_version", "run_id", "started_at", "runtime", "status", "data", "elapsed_ms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool_version": {"type": "string"},
    "run_id": {"type": "string", "format": "uuid"},
    "started_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object", "required": ["os", "python"],
      "properties": {"os": {"type": "string"}, "python": {"type": "string"}}
    },
    "command": {"enum": ["doctor", "models", "tts", "download"]},
    "status": {"enum": ["ok", "dry_run", "error"]},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "data": {
      "type": "object",
      "properties": {
        "model": {"type": "string"}, "voice": {"type": "string"},
        "region": {"enum": ["cn-beijing", "ap-southeast-1"]},
        "format": {"enum": ["wav", "mp3", "pcm", "opus"]},
        "text_characters": {"type": "integer", "minimum": 1},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_path": {"type": "string"},
        "request_id": {"type": ["string", "null"]},
        "audio_url": {"type": "string"}, "audio_id": {"type": ["string", "null"]},
        "expires_at": {"type": ["integer", "null"]},
        "usage": {"type": ["object", "null"]},
        "file": {
          "type": "object", "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "error": {
      "type": "object", "required": ["code", "message", "details"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "error"}}}, "then": {"required": ["error"]}},
    {"if": {"properties": {"status": {"enum": ["ok", "dry_run"]}}}, "then": {"required": ["command"], "not": {"required": ["error"]}}}
  ]
}
